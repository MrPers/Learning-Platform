{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "Secrets (passwords, keys, tokens) are NOT set here. Put them in appsettings.Secrets.json - see appsettings.Secrets.example.json.",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=elearning.db",
    "HangfireConnection": "hangfire.db"
  },

  "JWT": {
    "SecretKey": "",
    "Issuer": "https://localhost:7250/",
    "Audience": "https://localhost:4200/",
    "AccessTokenDurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7
  },

  "MailSettings": {
    "Email": "",
    "DisplayName": "E-Learning Platform",
    "Password": "",
    "Host": "smtp.gmail.com",
    "Port": 587
  },

  "Twilio": {
    "AccountSID": "",
    "AuthToken": "",
    "TwilioPhoneNumber": ""
  },

  "GoogleAuth": {
    "ClientIds": []
  },

  "Seed": {
    "AdminEmail": "admin@elearning.com",
    "AdminPassword": "",
    "DevUsersPassword": ""
  },

  "Frontend": {
    "BaseUrl": "https://localhost:4200",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password"
  },

  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200", "http://localhost:4200" ]
  },

  "Payments": {
    "Currency": "USD",
    "PlatformFeePercent": 20,
    "MinTopUp": 1,
    "MaxTopUp": 10000,
    "MinPayout": 10
  },

  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "WebhookToleranceSeconds": 300
  },

  "Hangfire": {
    "Storage": "SQLite"
  },

  "RateLimiting": {
    "AuthPermitLimit": 10,
    "PaymentsPermitLimit": 20
  },

  "Uploads": {
    "ImageSizeInMB": 5,
    "VideoSizeInMB": 500,
    "FileSizeInMB": 20,
    "ImageExtentionAllowed": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
    "VideoExtentionAllowed": [ ".mp4", ".mov", ".avi", ".mkv", ".webm" ],
    "FileExtentionAllowed": [ ".pdf", ".docx", ".xlsx", ".pptx", ".zip" ]
  },

  "EmailTemplates": {
    "WelcomePath": "EmailTemplates/Welcome.html",
    "ConfirmEmailPath": "EmailTemplates/ConfirmEmail.html",
    "ChangePasswordPath": "EmailTemplates/ChangePassword.html",
    "ResetPasswordPath": "EmailTemplates/ResetPassword.html",
    "TwoFactorCodePath": "EmailTemplates/TwoFactorCode.html"
  }
}

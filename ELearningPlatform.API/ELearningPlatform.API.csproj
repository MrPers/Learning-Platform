<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ELearningPlatform.API</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ELearningPlatform.Application\ELearningPlatform.Application.csproj" />
    <ProjectReference Include="..\ELearningPlatform.Infrastructure\ELearningPlatform.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local secrets: never published, never committed (see .gitignore) -->
    <Content Update="appsettings.Secrets.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Secrets.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

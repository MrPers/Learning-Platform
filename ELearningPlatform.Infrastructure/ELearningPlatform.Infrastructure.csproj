<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>ELearningPlatform.Infrastructure</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ELearningPlatform.Application\ELearningPlatform.Application.csproj" />
		<ProjectReference Include="..\ELearningPlatform.Domain\ELearningPlatform.Domain.csproj" />
		<ProjectReference Include="..\ELearningPlatform.Shared\ELearningPlatform.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
		<PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
		<PackageReference Include="Hangfire.Storage.SQLite" Version="0.4.3" />
		<PackageReference Include="MailKit" Version="4.18.2" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
		<PackageReference Include="MimeKit" Version="4.18.2" />
		<PackageReference Include="Stripe.net" Version="53.1.0" />
		<PackageReference Include="Twilio" Version="8.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="EmailTemplates\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ELearningPlatform.Infrastructure.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
